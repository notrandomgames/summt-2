rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidThreadToken(id) {
      return id is string && id.size() >= 28 && id.size() <= 64 && id.matches('^thr_[a-f0-9]+$');
    }

    function isValidLookupId(id) {
      return id is string && id.size() == 67 && id.matches('^lk_[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'emmannthiga25@gmail.com' ||
        request.auth.token.email == 'summit.digitalll@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPackageChoice(choice) {
      return choice in [
        'Starter Page (From KSh 200)',
        'Full Local Business Site (From KSh 300)',
        'Custom Order & Booking Site (From KSh 500)',
        'Not sure yet — help me choose'
      ];
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
          'name',
          'contact',
          'businessType',
          'packageChoice',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'contact',
          'businessType',
          'packageChoice',
          'message',
          'status',
          'threadId',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.contact is string && data.contact.size() >= 5 && data.contact.size() <= 120
        && data.businessType is string && data.businessType.size() >= 1 && data.businessType.size() <= 120
        && data.packageChoice is string && data.packageChoice.size() <= 80 && isValidPackageChoice(data.packageChoice)
        && data.message is string && data.message.size() >= 6 && data.message.size() <= 1500
        && data.status is string && data.status.size() <= 20 && data.status in ['new', 'replied', 'archived']
        && (!('threadId' in data.keys()) || isValidThreadToken(data.threadId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidThread(data) {
      return data.keys().hasAll([
          'inquiryId',
          'clientName',
          'businessType',
          'packageChoice',
          'status',
          'lastMessagePreview',
          'lastMessageBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'inquiryId',
          'clientName',
          'businessType',
          'packageChoice',
          'status',
          'lastMessagePreview',
          'lastMessageBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.inquiryId)
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100
        && data.businessType is string && data.businessType.size() >= 1 && data.businessType.size() <= 120
        && data.packageChoice is string && data.packageChoice.size() <= 80 && isValidPackageChoice(data.packageChoice)
        && data.status is string && data.status.size() <= 20 && data.status in ['new', 'replied', 'archived']
        && data.lastMessagePreview is string && data.lastMessagePreview.size() >= 1 && data.lastMessagePreview.size() <= 200
        && data.lastMessageBy is string && data.lastMessageBy.size() <= 20 && data.lastMessageBy in ['client', 'owner']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidThreadMessage(data) {
      return data.keys().hasAll([
          'threadId',
          'senderRole',
          'senderName',
          'body',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'threadId',
          'senderRole',
          'senderName',
          'body',
          'createdAt'
        ])
        && isValidThreadToken(data.threadId)
        && data.senderRole is string && data.senderRole.size() <= 20 && data.senderRole in ['client', 'owner']
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1500
        && data.createdAt is timestamp;
    }

    function isValidThreadLookupEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['threadId', 'businessType', 'clientName'])
        && entry.keys().hasOnly(['threadId', 'businessType', 'clientName'])
        && isValidThreadToken(entry.threadId)
        && entry.businessType is string && entry.businessType.size() >= 1 && entry.businessType.size() <= 120
        && entry.clientName is string && entry.clientName.size() >= 2 && entry.clientName.size() <= 100;
    }

    function isValidThreadLookup(data) {
      return data.keys().hasAll(['threads', 'updatedAt'])
        && data.keys().hasOnly(['threads', 'updatedAt'])
        && data.threads is list
        && data.threads.size() >= 1
        && data.threads.size() <= 10
        && isValidThreadLookupEntry(data.threads[0])
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId && isVerifiedUser();
      allow list, create, update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      // PII isolation: only the verified site owner may read or list client inquiries
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();

      // Public lead capture with atomic thread creation and server-timestamp enforcement
      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && 'threadId' in incoming().keys()
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/threads/$(incoming().threadId));

      // Owner can update status or attach a threadId once to legacy inquiries
      allow update: if isValidId(inquiryId)
        && isAdmin()
        && isValidInquiry(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          (!('threadId' in existing().keys()) && incoming().diff(existing()).affectedKeys().hasOnly(['threadId', 'status', 'updatedAt']))
        )
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /threadLookups/{lookupHash} {
      // Direct get by SHA-256 contact hash only; public listing is strictly disabled
      allow get: if isValidLookupId(lookupHash);
      allow list: if isAdmin();

      allow create: if isValidLookupId(lookupHash)
        && isValidThreadLookup(incoming())
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/threads/$(incoming().threads[0].threadId));

      allow update: if isValidLookupId(lookupHash)
        && isValidThreadLookup(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['threads', 'updatedAt'])
            && incoming().threads.size() >= existing().threads.size()
            && existsAfter(/databases/$(database)/documents/threads/$(incoming().threads[0].threadId))
          )
        );

      allow delete: if isValidLookupId(lookupHash) && isAdmin();
    }

    match /threads/{threadId} {
      // Unguessable 128-bit thread token grants direct get access without exposing PII or list enumeration
      allow get: if isValidThreadToken(threadId);
      allow list: if isAdmin();

      allow create: if isValidThreadToken(threadId)
        && isValidThread(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().lastMessageBy == 'owner') ||
          (
            incoming().status == 'new'
            && incoming().lastMessageBy == 'client'
            && existsAfter(/databases/$(database)/documents/inquiries/$(incoming().inquiryId))
          )
        );

      allow update: if isValidThreadToken(threadId)
        && isValidThread(incoming())
        && incoming().inquiryId == existing().inquiryId
        && incoming().clientName == existing().clientName
        && incoming().businessType == existing().businessType
        && incoming().packageChoice == existing().packageChoice
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastMessagePreview', 'lastMessageBy', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'lastMessageBy', 'updatedAt']) && incoming().lastMessageBy == 'client')
        );

      allow delete: if isValidThreadToken(threadId) && isAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(messageId) && (isAdmin() || isValidThreadToken(threadId));
        allow list: if isAdmin() || (isValidThreadToken(threadId) && resource.data.threadId == threadId);

        allow create: if isValidId(messageId)
          && isValidThreadMessage(incoming())
          && incoming().threadId == threadId
          && incoming().createdAt == request.time
          && (
            (incoming().senderRole == 'owner' && isAdmin()) ||
            (incoming().senderRole == 'client' && isValidThreadToken(threadId) && existsAfter(/databases/$(database)/documents/threads/$(threadId)))
          );

        allow update: if false;
        allow delete: if isValidId(messageId) && isAdmin();
      }
    }
  }
}
